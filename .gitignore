# Datos reales: PDFs de clientes, mapas de sustitución, informes. NUNCA a git.
data/*
!data/.gitkeep

# Por seguridad, ningún PDF fuera de los generados en tests (y esos se crean en tmp)
*.pdf

# Mapas de sustitución, por si acaban fuera de data/
*.map.json
*_map.json

# Python / uv
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
*.egg-info/
build/
dist/

# macOS / editores
.DS_Store
.vscode/
.idea/

# Configs de cliente: contienen los nombres que se anonimizan. Solo se
# versionan la base y el ejemplo ficticio.
configs/*
!configs/base.yaml
!configs/example.yaml
